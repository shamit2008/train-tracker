# Copy this file to .env and fill in your token. .env is git-ignored; this example file is safe to commit.
# Create a fine-grained token at https://github.com/settings/personal-access-tokens/new
#   Repository access: Only select repositories -> train-tracker
#   Permissions: Contents -> Read and write (nothing else)
GITHUB_TOKEN=
GITHUB_REPO=sm3625/train-tracker
GITHUB_BRANCH=main
# Comma-separated files to upload
DEPLOY_FILES=index.html,.gitignore,.env.example,deploy.mjs

# Optional, for the feeds worker (uploaded as Worker secrets by `cd worker && npm run deploy`):
# Metra's live feed (free key from https://metra.com/developers); Metra is left out without it.
METRA_API_KEY=
# the email service that sends password-reset links. Pick one and set MAIL_PROVIDER in worker/wrangler.toml.
# RESEND_API_KEY=
# BREVO_API_KEY=
