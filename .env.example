# Copy this file to .env and fill in your token. .env is git-ignored; this example file is safe to commit.
# Create a fine-grained token at https://github.com/settings/personal-access-tokens/new
#   Repository access: Only select repositories -> train-tracker
#   Permissions: Contents -> Read and write (nothing else)
GITHUB_TOKEN=
GITHUB_REPO=shamit2008/train-tracker
GITHUB_BRANCH=main
# Comma-separated files to upload
DEPLOY_FILES=index.html,.gitignore,.env.example,deploy.mjs
